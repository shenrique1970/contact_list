# Ignore bundler e dependências locais
/.bundle
/vendor/bundle

# Ignore logs e arquivos temporários
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore arquivos de credenciais e chaves
config/master.key
config/credentials.yml.enc

# Ignore dotenv (variáveis de ambiente locais)
.env
.env*.local

# Ignore uploads e storage em dev
/storage/*
!/storage/.keep
/public/uploads

# Ignore assets compilados
/public/packs
/public/packs-test
/public/assets

# Ignore node_modules
/node_modules/
/yarn-error.log
yarn-debug.log*
.yarn-integrity

# Ignore arquivos de debug
.byebug_history

# Ignore coverage de testes
/coverage/

# Ignore arquivos gerados por testes
/spec/tmp
