<div class="container mb-5">
  <h2 class="mb-4">Meus Contatos</h2>
  <!-- index.html.erb -->
  <%= link_to "Adicionar Novo Contato", new_contact_path, class: "btn btn-primary mb-3" %>    

  <!-- Tabela de contatos -->
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <tr>
        <th>Nome</th>
        <th>Email</th>
        <th>Telefone</th>
        <th>Empresa</th>
        <th>Cargo</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @contacts.each do |contact| %>
        <tr>
          <td><%= contact.name %></td>
          <td><%= contact.email %></td>
          <td><%= contact.phone %></td>
          <td><%= contact.company %></td>
          <td><%= contact.position %></td>
          <td>
            <%= link_to "Mostrar", contact, class: "btn btn-success btn-sm" %>
            <%= link_to "Editar", edit_contact_path(contact), class: "btn btn-warning btn-sm" %>
            <%= link_to "Excluir", contact_path(contact), data: { turbo_method: :delete, turbo_confirm: "Tem certeza?" }, class: "btn btn-danger btn-sm" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
