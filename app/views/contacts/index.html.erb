<div class="container mb-5">
  <h2 class="mb-4">Meus Contatos</h2>

  <!-- Tabela de contatos -->
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <tr>
        <th>Nome</th>
        <th>Email</th>
        <th>Telefone</th>
        <th>Empresa</th>
        <th>Cargo</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @contacts.each do |contact| %>
        <tr>
          <td><%= contact.name %></td>
          <td><%= contact.email %></td>
          <td><%= contact.phone %></td>
          <td><%= contact.company %></td>
          <td><%= contact.position %></td>
          <td>
            <%= link_to "Editar", edit_contact_path(contact), class: "btn btn-sm btn-warning" %>
            <%= link_to "Excluir", contact, method: :delete, data: { confirm: "Tem certeza?" }, class: "btn btn-sm btn-danger" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <hr class="my-4">

  <!-- Formulário de novo contato -->
  <h3>Adicionar Novo Contato</h3>
  <%= render "form", contact: Contact.new %>
</div>
