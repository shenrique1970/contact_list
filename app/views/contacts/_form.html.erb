<%= form_with(model: @contact, local: true, class: "needs-validation") do |form| %>
  <div class="mb-2">
    <%= form.label :name, "Nome", class: "form-label" %>
    <%= form.text_field :name, class: "form-control", required: true %>
  </div>

  <div class="mb-2">
    <%= form.label :email, "Email", class: "form-label" %>
    <%= form.email_field :email, class: "form-control" %>
  </div>

  <div class="mb-2">
    <%= form.label :phone, "Telefone", class: "form-label" %>
    <%= form.telephone_field :phone, class: "form-control" %>
  </div>

  <div class="mb-2">
    <%= form.label :company, "Empresa", class: "form-label" %>
    <%= form.text_field :company, class: "form-control" %>
  </div>

  <div class="mb-2">
    <%= form.label :position, "Cargo", class: "form-label" %>
    <%= form.text_field :position, class: "form-control" %>
  </div>

  <%= form.submit "Salvar", class: "btn btn-primary" %>
<% end %>
