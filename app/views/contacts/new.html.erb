<div class="row">
  <div class="col-12">
    <h1>Adicionar Novo Contato</h1>
  </div>

  <div class="col-md-6 offset-md-3 col-12">
    <%= form_with(model: @contact, local: true, class: "needs-validation") do |f| %>
      <%= render "form", f: f %>
      <%= link_to "Voltar", contacts_path, class: "btn btn-secondary mt-3" %>
    <% end %>
  </div>
</div>
